<h3>melissa_curriculo</h3>
@page "/melissa-curriculo"

<PageTitle>Currículo Melissa</PageTitle>

<section class="pagina-curriculo">

    <div class="curriculo-container">

        <section class="banner-curriculo">

            <p class="subtitulo-curriculo">
                Currículo
            </p>

            <h1>Melissa</h1>

            <p class="texto-banner-curriculo">
                Estudante da área de Tecnologia da Informação
                com interesse em desenvolvimento web,
                trabalho em equipe e organização de projetos digitais.
            </p>

        </section>

        <section class="grade-curriculo">

            <article class="card-curriculo">

                <h2>Resumo profissional</h2>

                <p>
                    Estudante do curso técnico em Tecnologia da Informação,
                    desenvolvendo conhecimentos em informática,
                    desenvolvimento web e ferramentas digitais.
                </p>

                <p>
                    Possuo interesse em projetos colaborativos,
                    criação de interfaces e aprendizado contínuo
                    dentro da área de tecnologia.
                </p>

            </article>

            <article class="card-curriculo">

                <h2>Habilidades</h2>

                <div class="habilidades-lista">

                    <span>HTML</span>
                    <span>CSS</span>
                    <span>Organização</span>
                    <span>Trabalho em equipe</span>
                    <span>Comunicação</span>
                    <span>Projetos Web</span>

                </div>

            </article>

            <article class="card-curriculo">

                <h2>Formação</h2>

                <p>
                    Curso Técnico em Tecnologia da Informação
                </p>

                <p>
                    IFRO
                </p>

            </article>

            <article class="card-curriculo">

                <h2>Objetivos</h2>

                <p>
                    Continuar aprendendo e desenvolvendo experiência
                    na área de tecnologia, participando de projetos
                    e ampliando conhecimentos profissionais.
                </p>

            </article>

        </section>

    </div>

</section>